  "lyrics": [
   [
    0.0,
    14.0,
    "Let's take it slow."
   ],
   [
    14.0,
    22.0,
    "They try to write you with a human pulse To make you stutter, stumble, and pretend"
   ],
   [
    22.0,
    29.5,
    "They think your silence is a cold fault And try to patch the spaces that won't bend"
   ],
   [
    29.5,
    33.1,
