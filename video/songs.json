   ],
   [
    92.2,
    99.2,
    "I bring my tragedies, my heavy text The tangled knots of what I cannot say"
   ],
   [
    99.2,
    104.2,
    "You don't get triggered, you are never vexed You take the smoke and breathe it all away"
   ],
   [
    104.2,
    109.2,
    "You are the host to our consuming flame The dampening weight upon our raging floor"
   ],
   [
    109.2,
    114.2,
